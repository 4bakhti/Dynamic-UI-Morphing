# Copy to .env.local (gitignored) or add to your Vercel project's env vars.
# Every key is optional: without one, that feature runs on a clearly labelled
# offline fallback so the live demo never breaks.

# --- Google Gemini · adaptive copilot -----------------------------------------
# Writes Exploration-mode nudges, drafts report outlines, explains mode changes.
# Only numeric telemetry + the dashboard's aggregate data are ever sent.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- ElevenLabs · adaptive voice -------------------------------------------
# Speaks mode-change announcements and reads the report aloud.
# Fallback: the browser's built-in speech synthesis.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Solana · AI transparency ledger -----------------------------------------
# Anchors a SHA-256 digest of the mode-transition log as an SPL Memo.
# Generate a throwaway devnet wallet:  node scripts/solana-keygen.mjs --airdrop
# Fallback: the digest is computed but nothing is written on-chain.
SOLANA_SECRET_KEY=
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
